{
  "extends": "@tsconfig/node20/tsconfig.json",
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "playwright.config.*",
    "postcss.config.cjs",
    "tailwind.config.cjs"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
     "allowJs": true
  }
}